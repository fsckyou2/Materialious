FROM node:24-alpine AS builder
WORKDIR /app

COPY . .

# Tell SvelteKit to use node adapter.
ENV PUBLIC_BUILD_WITH_BACKEND="true"

# Installing, building and pruning in one step keeps the dependencies in the
# layer that pruning removes them from. Split across layers, pruning has to
# rename files that live in a layer below it, and overlay2 has to copy each one
# up before it can, which turns a delete into a copy of everything being
# deleted. On one machine that took a single step from seconds to over an hour.
RUN npm ci && npm run build && npm prune --omit=dev

# Packages the server never loads. capacitor-nodejs alone is nearly 200MB of
# Android runtime, and the build tooling that survives the prune is only there
# because production packages happen to depend on it. Dropping them here keeps
# every deploy's upload a good deal smaller.
RUN rm -rf \
	node_modules/capacitor-nodejs \
	node_modules/@trapezedev \
	node_modules/@rolldown \
	node_modules/typescript \
	node_modules/lightningcss-linux-x64-gnu \
	node_modules/lightningcss-linux-x64-musl

FROM node:24-alpine

WORKDIR /app

COPY --from=builder /app/build build/
COPY --from=builder /app/node_modules node_modules/

COPY package.json .
EXPOSE 3000
ENV NODE_ENV=production

# Tell the front end backend is in use.
ENV PUBLIC_BUILD_WITH_BACKEND="true"

CMD ["node", "build"]
